    {
      "parameters": {
        "operation": "executeQuery",
        "query": " WITH faturas AS (\n  SELECT\n    c.nome, \n    c.bandeira,\n    c.numero,\n    limite_total,\n    fechamento_dia,\n    vencimento_dia,\n    nomecartao,\n    f.*,\n    ROW_NUMBER() OVER (\n      PARTITION BY f.cartao_id\n      ORDER BY f.mes_referencia ASC\n    ) AS rn\n  FROM cartoes_faturas AS f\n  INNER JOIN cartoes AS c\n    ON c.id = f.cartao_id\n   AND c.empresa_id = f.empresa_id\n  WHERE f.empresa_id = {{ $json.id_empresa }}\n    AND (f.cartao_id = {{ $json.id }} OR {{ $json.id }} = 0)\n    AND (f.status = '{{ $json.status }}' OR '{{ $json.status }}' = '')\n)\nSELECT *\nFROM faturas\nWHERE rn <= 2\nORDER BY\n  cartao_id,\n  mes_referencia ASC;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
