      "parameters": {
        "operation": "executeQuery",
        "query": " SELECT \n  crp.id AS controle_id,\n  crp.empresa_id,\n  crp.lote_conciliacao_id,\n  crp.conciliacao_financeira_id,\n  crp.transacao_id,\n  crp.tipo_evento AS controle_tipo_evento,\n  crp.status AS controle_status,\n  crp.acao,\n  crp.conta_pagar_id,\n  crp.conta_receber_id,\n  crp.recorrente_id,\n\n  cf.data_mov,\n  cf.valor,\n  cf.historico,\n  cf.tipo,\n  cf.forma,\n  cf.classificacao,\n  cf.tipo_evento AS conciliacao_tipo_evento,\n  cf.match_score,\n  cf.match_criterio,\n\n  p.id AS pessoa_id,\n  p.nome AS pessoa_nome,\n  p.cpf_cnpj AS pessoa_cpf_cnpj,\n  p.tipo AS pessoa_tipo\n\nFROM public.conta_pagar_receber_conciliacao crp\nJOIN public.conciliacao_financeira cf\n  ON cf.id = crp.conciliacao_financeira_id\nLEFT JOIN public.pessoa p\n  ON p.id = cf.fornecedor_id\n AND p.empresa_id = cf.empresa_id\nWHERE crp.empresa_id =  {{ $json.id_empresa }}\n  AND (\n    {{ $json.lote_conciliacao_id || 0 }} = 0\n    OR crp.lote_conciliacao_id = {{ $json.lote_conciliacao_id || 0 }}\n  )\nORDER BY crp.id DESC;",
