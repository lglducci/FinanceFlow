    {
      "parameters": {
        "jsCode": " function apenasNumeros(v) {\n  return String(v || \"\").replace(/\\D/g, \"\");\n}\n\nfunction cpfValido(cpf) {\n  cpf = apenasNumeros(cpf);\n  if (cpf.length !== 11) return false;\n  if (/^(\\d)\\1+$/.test(cpf)) return false;\n\n  let soma = 0;\n  for (let i = 0; i < 9; i++) soma += Number(cpf[i]) * (10 - i);\n  let d1 = 11 - (soma % 11);\n  d1 = d1 >= 10 ? 0 : d1;\n\n  soma = 0;\n  for (let i = 0; i < 10; i++) soma += Number(cpf[i]) * (11 - i);\n  let d2 = 11 - (soma % 11);\n  d2 = d2 >= 10 ? 0 : d2;\n\n  return d1 === Number(cpf[9]) && d2 === Number(cpf[10]);\n}\n\nfunction cnpjValido(cnpj) {\n  cnpj = apenasNumeros(cnpj);\n  if (cnpj.length !== 14) return false;\n  if (/^(\\d)\\1+$/.test(cnpj)) return false;\n\n  const calc = (base, pesos) => {\n    const soma = base.split(\"\").reduce((acc, n, i) => acc + Number(n) * pesos[i], 0);\n    const resto = soma % 11;\n    return resto < 2 ? 0 : 11 - resto;\n  };\n\n  const d1 = calc(cnpj.slice(0, 12), [5,4,3,2,9,8,7,6,5,4,3,2]);\n  const d2 = calc(cnpj.slice(0, 13), [6,5,4,3,2,9,8,7,6,5,4,3,2]);\n\n  return d1 === Number(cnpj[12]) && d2 === Number(cnpj[13]);\n}\n\nreturn items.map(item => {\n  const doc = apenasNumeros(item.json.cpf_cnpj);\n\n  const tipo_documento =\n    doc.length === 14 && cnpjValido(doc) ? \"CNPJ\" :\n    doc.length === 11 && cpfValido(doc) ? \"CPF\" :\n    null;\n\n  return {\n    json: {\n      ...item.json,\n      documento_limpo: doc,\n      tipo_documento,\n      documento_valido: !!tipo_documento,\n      consultar_cnpj: tipo_documento === \"CNPJ\"\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        112,
        -80
      ],
      "id": "dbb99920-851a-464a-ad1b-27e8ecf237ec",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": " return items.map(item => {\n  const j = item.json;\n\n  const deuCerto =\n    j.cnpj &&\n    j.razao_social &&\n    !j.error &&\n    !j.message;\n\n  return {\n    json: {\n      ...j,\n      consulta_cnpj_ok: deuCerto,\n      razao_social_api: deuCerto ? j.razao_social : null,\n      nome_fantasia_api: deuCerto ? j.nome_fantasia : null,\n      situacao_cadastral_api: deuCerto ? j.descricao_situacao_cadastral : null,\n      cnae_api: deuCerto ? j.cnae_fiscal_descricao : null,\n      erro_cnpj_api: deuCerto ? null : (j.message || j.error || \"Erro ao consultar CNPJ\")\n    }\n  };\n});"
      },
