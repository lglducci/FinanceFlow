    {
      "parameters": {
        "operation": "executeQuery",
        "query": " WITH competencia_atual AS (\n  SELECT date_trunc('month', current_date)::date AS competencia\n)\nSELECT\n  r.*,\n\n  c.competencia,\n\n  CASE\n    WHEN g.id IS NULL THEN false\n    ELSE true\n  END AS gerado_mes_atual,\n\n  g.data_pagamento,\n  g.valor_gerado,\n  g.conta_id AS conta_pagamento_id,\n\n  CASE\n    WHEN g.id IS NULL THEN 'PENDENTE'\n    ELSE 'GERADO'\n  END AS status_mes\n\nFROM public.contas_recorrentes r\nCROSS JOIN competencia_atual c\nLEFT JOIN public.contas_recorrentes_geradas g\n  ON g.empresa_id = r.empresa_id\n AND g.recorrente_id = r.id\n AND date_trunc('month', g.competencia)::date = c.competencia\n\nWHERE r.empresa_id = {{ $json.empresa_id }}::bigint\n  AND r.ativo = true\n\nORDER BY\n  CASE WHEN g.id IS NULL THEN 0 ELSE 1 END,\n  r.dia_vencimento,\n  r.descricao;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
