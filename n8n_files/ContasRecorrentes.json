    {
      "parameters": {
        "operation": "executeQuery",
        "query": " WITH competencia_atual AS (\n  SELECT date_trunc('month', current_date)::date AS competencia\n),\npendentes AS (\n  SELECT\n    r.id,\n    r.descricao,\n    r.dia_vencimento,\n    r.valor_padrao,\n    r.conta_id\n  FROM public.contas_recorrentes r\n  CROSS JOIN competencia_atual c\n  WHERE r.empresa_id = {{ $json.empresa_id }}::bigint\n    AND r.ativo = true\n    AND NOT EXISTS (\n      SELECT 1\n      FROM public.contas_recorrentes_geradas g\n      WHERE g.empresa_id = r.empresa_id\n        AND g.recorrente_id = r.id\n        AND date_trunc('month', g.competencia)::date = c.competencia\n    )\n)\nSELECT\n  true AS ok,\n  COUNT(*) AS qtd,\n  CASE\n    WHEN COUNT(*) = 0 THEN 'Nenhuma conta recorrente pendente'\n    WHEN COUNT(*) = 1 THEN '1 conta recorrente pendente'\n    ELSE COUNT(*) || ' contas recorrentes pendentes'\n  END AS message\nFROM pendentes;",
        "options": {}
      },
