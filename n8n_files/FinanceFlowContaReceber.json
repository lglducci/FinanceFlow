    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": " SELECT \n    cp.lote_id,\n    cp.descricao,\n    p.nome AS fornecedor_nome,\n    c.nome AS categoria_nome,\n   cp.criado_em,\n    MAX(cp.parcelas) AS parcelas,\n    CASE\n        WHEN SUM(CASE WHEN cp.status = 'recebido' THEN 1 ELSE 0 END) > 0\n        THEN 'Parcela Recebida'\n        ELSE 'aberto'\n    END AS status,\n    SUM(cp.valor) AS valor_total\nFROM contas_a_receber cp\nLEFT JOIN pessoa p \n       ON p.id = cp.fornecedor_id\nLEFT JOIN categorias_gerenciais c \n       ON c.id = cp.categoria_id\nWHERE cp.empresa_id = {{ $json.empresa_id }}\n  AND ({{ $json.lote_id }} = 0 OR cp.lote_id IS NULL OR cp.lote_id = {{ $json.lote_id }})\n  AND (cp.fornecedor_id = {{ $json.fornecedor_id }} OR {{ $json.fornecedor_id }} = 0)\n  AND (cp.categoria_id = {{ $json.categoria_id }} OR {{ $json.categoria_id }} = 0)\n  AND cp.parcelas > 1\nGROUP BY \n    cp.lote_id,\n    cp.descricao,\n    cp.criado_em,\n    p.nome,\n    c.nome\nORDER BY cp.lote_id;\n",
        "options": {}
      },
